# Team mode (optional). Leave empty to run Tideline in local mode,
# where boards are stored in the browser and no account is needed.
# Find these in Firebase: Project settings -> Your apps -> Web app config.
# Put them in .env.production (deploys) and/or .env.local (development).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to 1 to use `npm run emulators` instead of a real project.
VITE_FIREBASE_EMULATOR=
