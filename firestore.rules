rules_version = '2';

// Cue access rules.
// Accounts are created by an admin (server side). Only signed-in users with a
// /members/{uid} row can read anything; viewers read, members and admins edit.
// Nobody can change /members from the browser: the admin server does that.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function memberDoc() {
      return /databases/$(database)/documents/members/$(uid());
    }
    function isMember() {
      return signedIn() && exists(memberDoc());
    }
    function role() {
      return get(memberDoc()).data.role;
    }
    function canEdit() {
      return isMember() && role() in ['admin', 'member'];
    }
    // The only login allowed to claim a fresh workspace. Filled in at deploy
    // time by scripts/build-rules.mjs, so it never lives in the repository.
    function ownerLogin() {
      return '__OWNER_EMAIL__';
    }
    // ownership fields must never be rewritten
    function keeps(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    function keepsOwnership() {
      return request.resource.data.id == resource.data.id
        && keeps('authorId') && keeps('actorId') && keeps('userId') && keeps('createdBy');
    }
    function idMatches(id) {
      return request.resource.data.id == id;
    }

    // ---------- workspace setup & team ----------
    // existence flag only (no personal data): "has this workspace been claimed?"
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.email == ownerLogin()
        && request.resource.data.keys().hasOnly(['at'])
        && getAfter(memberDoc()).data.role == 'admin';
    }

    match /members/{memberId} {
      allow read: if isMember() || (signedIn() && memberId == uid());
      // the owner's one-time claim of a fresh workspace; everything else is server-side
      allow create: if signedIn() && memberId == uid()
        && request.auth.token.email == ownerLogin()
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/meta/setup);
      // a member may only clear their own "must change password" flag
      allow update: if signedIn() && memberId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
    }

    // ---------- shared team work ----------
    match /{kind}/{id} {
      allow read: if isMember() && kind in ['workspace', 'board', 'item', 'update', 'user', 'activity', 'doc', 'dashboard'];
    }
    match /workspace/{id} {
      allow create: if canEdit() && idMatches(id);
      allow update: if canEdit() && keepsOwnership();
      allow delete: if canEdit();
    }
    match /board/{id} {
      allow create: if canEdit() && idMatches(id);
      allow update: if canEdit() && keepsOwnership();
      allow delete: if canEdit();
    }
    match /item/{id} {
      allow create: if canEdit() && idMatches(id);
      allow update: if canEdit() && keepsOwnership();
      allow delete: if canEdit();
    }
    match /doc/{id} {
      allow create: if canEdit() && idMatches(id);
      allow update: if canEdit() && keepsOwnership();
      allow delete: if canEdit();
    }
    match /dashboard/{id} {
      allow create: if canEdit() && idMatches(id);
      allow update: if canEdit() && keepsOwnership();
      allow delete: if canEdit();
    }

    // ---------- personal rows ----------
    // profiles: your own, or placeholder teammates (ids starting with u_)
    match /user/{id} {
      allow create, update: if isMember() && idMatches(id) && (id == uid() || (canEdit() && id.matches('u_.*')));
    }

    // comments: written as yourself; others may only add/remove their own like
    match /update/{id} {
      allow create: if isMember() && idMatches(id) && request.resource.data.authorId == uid();
      allow update: if isMember() && keepsOwnership()
        && (resource.data.authorId == uid() || onlyMyLikeChanged());
      allow delete: if isMember() && resource.data.authorId == uid();

      function onlyMyLikeChanged() {
        let before = resource.data.get('likes', []);
        let after = request.resource.data.get('likes', []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && (
            (!(uid() in before) && after.size() == before.size() + 1 && after.hasAll(before) && uid() in after)
            || (uid() in before && after == before.removeAll([uid()]))
          );
      }
    }

    // activity log: append-only, written as yourself
    match /activity/{id} {
      allow create: if isMember() && idMatches(id) && request.resource.data.actorId == uid();
    }

    // notifications: sent as yourself; only recipient or sender can read / mark read
    match /notification/{id} {
      allow read: if isMember() && (resource.data.userId == uid() || resource.data.actorId == uid());
      allow create: if isMember() && idMatches(id) && request.resource.data.actorId == uid();
      allow update: if isMember() && keepsOwnership()
        && (resource.data.userId == uid() || resource.data.actorId == uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
