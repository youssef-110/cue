rules_version = '2';

// Cue access rules.
// Accounts are created by an admin (server side). Only signed-in users with a
// /members/{uid} row can read anything; viewers read, members and admins edit.
// Nobody can change /members from the browser: the admin server does that.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function memberDoc() {
      return /databases/$(database)/documents/members/$(uid());
    }
    function isMember() {
      return signedIn() && exists(memberDoc());
    }
    function role() {
      return get(memberDoc()).data.role;
    }
    function canEdit() {
      return isMember() && role() in ['admin', 'member'];
    }
    // The only login allowed to claim a fresh workspace. Filled in at deploy
    // time by scripts/build-rules.mjs, so it never lives in the repository.
    function ownerLogin() {
      return '__OWNER_EMAIL__';
    }
    // ownership fields must never be rewritten
    function keeps(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    function keepsOwnership() {
      return request.resource.data.id == resource.data.id
        && keeps('authorId') && keeps('actorId') && keeps('userId') && keeps('createdBy');
    }
    function idMatches(id) {
      return request.resource.data.id == id;
    }

    // ---------- workspace setup & team ----------
    // existence flag only (no personal data): "has this workspace been claimed?"
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.email == ownerLogin()
        && request.resource.data.keys().hasOnly(['at'])
        && getAfter(memberDoc()).data.role == 'admin';
    }

    match /members/{memberId} {
      allow read: if isMember() || (signedIn() && memberId == uid());
      // the owner's one-time claim of a fresh workspace; everything else is server-side
      allow create: if signedIn() && memberId == uid()
        && request.auth.token.email == ownerLogin()
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/meta/setup);
      // a member may only clear their own "must change password" flag
      allow update: if signedIn() && memberId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
    }

    // ---------- shared team work ----------
    // Boards and everything on them carry `readers`: ['*'] for the whole team, otherwise
    // the user ids a private board is shared with. Admins can open every board.
    // Readers only change through the team server, which restamps a board's documents together.
    function isAdmin() {
      return isMember() && role() == 'admin';
    }
    function canSee(d) {
      return isAdmin() || d.readers.hasAny(['*', uid()]);
    }
    function boardOf(d) {
      return get(/databases/$(database)/documents/board/$(d.boardId)).data;
    }
    // a new or moved document must carry exactly its board's readers (docs without a board are public)
    function stampedLikeBoard() {
      let d = request.resource.data;
      return d.get('boardId', null) == null
        ? d.readers == ['*']
        : d.readers == boardOf(d).readers;
    }
    function readersKept() {
      return keeps('readers') && keeps('boardId');
    }

    match /{kind}/{id} {
      allow read: if isMember() && (
        kind in ['workspace', 'user', 'dashboard', 'event']
        || (kind in ['board', 'item', 'update', 'activity', 'doc', 'kpi'] && canSee(resource.data))
      );
    }
    match /workspace/{id} {
      allow create: if canEdit() && idMatches(id);
      allow update: if canEdit() && keepsOwnership();
      allow delete: if canEdit();
    }
    match /board/{id} {
      // created public, by you; createdBy (who may change access) never changes afterwards
      allow create: if canEdit() && idMatches(id) && request.resource.data.readers == ['*'] && request.resource.data.createdBy == uid();
      allow update: if canEdit() && keepsOwnership() && canSee(resource.data) && keeps('readers');
      // deleting for good (and so freeing the id to be re-created) is for the creator or an admin;
      // everyone else uses the trash, which is an update
      allow delete: if canEdit() && canSee(resource.data) && (isAdmin() || resource.data.get('createdBy', null) == uid());
    }
    match /item/{id} {
      allow create: if canEdit() && idMatches(id) && stampedLikeBoard() && canSee(request.resource.data);
      allow update: if canEdit() && keepsOwnership() && canSee(resource.data) && (readersKept() || (stampedLikeBoard() && canSee(request.resource.data)));
      allow delete: if canEdit() && canSee(resource.data);
    }
    match /doc/{id} {
      allow create: if canEdit() && idMatches(id) && stampedLikeBoard() && canSee(request.resource.data);
      allow update: if canEdit() && keepsOwnership() && canSee(resource.data) && readersKept();
      allow delete: if canEdit() && canSee(resource.data);
    }
    match /dashboard/{id} {
      allow create: if canEdit() && idMatches(id);
      allow update: if canEdit() && keepsOwnership();
      allow delete: if canEdit();
    }
    // KPI boards (fundraise, money, pipeline, team): private to their maker until shared.
    // Unlike boards they are one document, so the maker or an admin changes `readers` here directly,
    // and nobody can write themselves out of a board they keep editing.
    function readersOk(d) {
      return d.readers == ['*'] || (d.readers is list && d.readers.size() > 0 && d.readers.size() <= 100 && (isAdmin() || uid() in d.readers));
    }
    match /kpi/{id} {
      allow create: if canEdit() && idMatches(id) && request.resource.data.createdBy == uid() && readersOk(request.resource.data);
      allow update: if canEdit() && keepsOwnership() && canSee(resource.data) && readersOk(request.resource.data)
        && (keeps('readers') || isAdmin() || resource.data.createdBy == uid());
      allow delete: if canEdit() && canSee(resource.data) && (isAdmin() || resource.data.createdBy == uid());
    }

    // ---------- calendar ----------
    // Everyone on the team sees everyone's schedule; each person creates, changes and deletes
    // only their own events, and an event never changes owner. Viewers only read.
    function eventOk(d) {
      let wall = '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$';
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.start is string && d.start.matches(wall)
        && d.end is string && d.end.matches(wall) && d.end >= d.start;
    }
    match /event/{id} {
      allow create: if canEdit() && idMatches(id) && request.resource.data.ownerId == uid() && eventOk(request.resource.data);
      allow update: if canEdit() && resource.data.ownerId == uid() && keeps('ownerId') && idMatches(id) && eventOk(request.resource.data);
      allow delete: if canEdit() && resource.data.ownerId == uid();
    }

    // ---------- personal rows ----------
    // profiles: your own, or placeholder teammates (ids starting with u_)
    match /user/{id} {
      allow create, update: if isMember() && idMatches(id) && (id == uid() || (canEdit() && id.matches('u_.*')));
    }

    // comments: written as yourself; others may only add/remove their own like
    match /update/{id} {
      allow create: if isMember() && idMatches(id) && request.resource.data.authorId == uid() && stampedLikeBoard() && canSee(request.resource.data);
      allow update: if isMember() && keepsOwnership() && canSee(resource.data) && readersKept()
        && (resource.data.authorId == uid() || onlyMyLikeChanged());
      allow delete: if isMember() && resource.data.authorId == uid();

      function onlyMyLikeChanged() {
        let before = resource.data.get('likes', []);
        let after = request.resource.data.get('likes', []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && (
            (!(uid() in before) && after.size() == before.size() + 1 && after.hasAll(before) && uid() in after)
            || (uid() in before && after == before.removeAll([uid()]))
          );
      }
    }

    // activity log: append-only, written as yourself
    match /activity/{id} {
      allow create: if isMember() && idMatches(id) && request.resource.data.actorId == uid() && stampedLikeBoard() && canSee(request.resource.data);
    }

    // notifications: sent as yourself; only recipient or sender can read / mark read
    match /notification/{id} {
      allow read: if isMember() && (resource.data.userId == uid() || resource.data.actorId == uid());
      allow create: if isMember() && idMatches(id) && request.resource.data.actorId == uid();
      allow update: if isMember() && keepsOwnership()
        && (resource.data.userId == uid() || resource.data.actorId == uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
